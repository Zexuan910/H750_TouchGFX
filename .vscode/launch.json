{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Debug bootloader",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "deviceName": "STM32H750XBH6",
            "deviceCore": "Cortex-M7",
            "deviceTrustzone": "TZ-disabled",
            "serverInterface": "SWD",
            "serverInterfaceFrequency": "140",
            "serverReset": "Connect under reset",
            "serverVerify": true,
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Release/H750_TouchGFX_bootloader.elf",
                    "symbolFileName": "${workspaceFolder}/build/Release/H750_TouchGFX_bootloader.elf"
                }
            ]
        }
    ]
}
